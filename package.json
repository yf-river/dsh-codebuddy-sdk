{
  "name": "dsh-codebuddy-sdk",
  "version": "0.1.0",
  "description": "DeepSeek Harness plugin: CodeBuddy (Tencent Agent SDK) as an LLM provider (ctx.llm).",
  "type": "module",
  "main": "dist/index.js",
  "exports": {
    ".": "./dist/index.js"
  },
  "files": [
    "dist",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test:ci": "node --import tsx --test tests/smoke.test.mjs tests/unit-*.mjs",
    "test:integration": "CODEBUDDY_SDK_INTEGRATION=1 node --import tsx --test tests/integration-cli.test.mjs",
    "test": "node --import tsx --test tests/*.mjs",
    "typecheck": "tsc --noEmit",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "prepack": "npm run clean && npm run build",
    "prepublishOnly": "npm run clean && npm run build"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "cordis",
    "codebuddy",
    "llm"
  ],
  "license": "MIT",
  "dependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-credentials": "^0.0.1-rc.1",
    "@deepseek-ai/dsh-llm": "^0.0.1-rc.1",
    "@deepseek-ai/schemastery": "^3.18.0",
    "@tencent-ai/agent-sdk": "^0.3.267",
    "change-case": "^5.4.4",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.5.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RetiredPhysicist/dsh-plugins.git",
    "directory": "packages/dsh-codebuddy-sdk"
  }
}
